# Deny access to the .git directory and its contents
RedirectMatch 404 /\.git
# Deny access to the cache directory (holds the Solarman API token)
RedirectMatch 404 ^/cache(/|$)
# Deny access to cron scripts and their Composer dependencies
RedirectMatch 404 ^/scripts(/|$)

# Firmware updates for the sensors and Klaussometers. The binaries contain credentials, so only
# the home ISP (RSAWEB, AS37053) can download them. Same ranges as the rsaweb-ipv4 AWS prefix
# list and the /node-red/ block in Setup/apache/watsonia22.com-le-ssl.conf.
<If "%{REQUEST_URI} =~ m#^/(klaussometer|sensor)(/|$)#">
    Require ip 41.71.0.0/17 41.74.176.0/20 41.79.36.0/22 41.79.156.0/22 41.215.232.0/21
    Require ip 41.223.32.0/22 102.206.208.0/22 102.210.136.0/22 102.212.192.0/21 102.213.64.0/22
    Require ip 102.214.92.0/22 102.215.212.0/22 102.217.28.0/22 102.217.32.0/21 102.217.40.0/22
    Require ip 102.217.76.0/22 165.0.0.0/16 196.1.130.0/24 196.46.31.0/24
</If>
# --- General Best Practices ---
Options -Indexes

# --- Security: Deny Direct Access to Sensitive Files ---
<Files "vars.php">
    Require all denied
</Files>

<Files "auth.php">
    Require all denied
</Files>

<Files "solarman_lib.php">
    Require all denied
</Files>

# AC control is shelved: the page and its unauthenticated MQTT publisher are
# kept in the repo but not served. Delete this block to re-enable.
<FilesMatch "^(ac_control\.html|mqtt_publish\.php)$">
    Require all denied
</FilesMatch>

# --- Performance: Set Cache Headers ---
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 week"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
</IfModule>