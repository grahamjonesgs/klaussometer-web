# Deny access to the .git directory and its contents
RedirectMatch 404 /\.git
# Deny access to the cache directory (holds the Solarman API token)
RedirectMatch 404 ^/cache(/|$)
# Deny access to cron scripts and their Composer dependencies
RedirectMatch 404 ^/scripts(/|$)
# --- General Best Practices ---
Options -Indexes

# --- Security: Deny Direct Access to Sensitive Files ---
<Files "vars.php">
    Require all denied
</Files>

<Files "auth.php">
    Require all denied
</Files>

<Files "solarman_lib.php">
    Require all denied
</Files>

# AC control is shelved: the page and its unauthenticated MQTT publisher are
# kept in the repo but not served. Delete this block to re-enable.
<FilesMatch "^(ac_control\.html|mqtt_publish\.php)$">
    Require all denied
</FilesMatch>

# --- Performance: Set Cache Headers ---
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 week"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
</IfModule>