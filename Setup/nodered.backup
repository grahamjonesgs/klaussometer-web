    {
        "id": "7c939f2b06cd6af6",
        "type": "function",
        "z": "16875acb6e261384",
        "name": "Convert to JS",
        "func": "var room=msg.topic.substr(0,msg.topic.indexOf(\"/\"))\n\nvar msgtype=msg.topic.slice(msg.topic.indexOf(\"/\")+1,msg.topic.lastIndexOf(\"/\"))\nmsg.payload = {\"type\":msgtype,\"room\":room  ,   \"value\": msg.payload};\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "x": 480,
        "y": 280,
        "wires": [
            [
                "0d50ad3149e95c9c"
            ]
        ]
    },
    {
        "id": "0d50ad3149e95c9c",
        "type": "change",
        "z": "16875acb6e261384",
        "name": "SQL Insert",
        "rules": [
            {
                "t": "set",
                "p": "payload",
                "pt": "msg",
                "to": "(\t   \"insert into rec_data values (\\\"\" &  msg.payload.room & \"\\\",\\\"\" & msg.payload.value & \"\\\",\\\"\" & msg.payload.type & \"\\\", DEFAULT)\"\t)",
                "tot": "jsonata"
            }
        ],
        "action": "",
        "property": "",
        "from": "",
        "to": "",
        "reg": false,
        "x": 450,
        "y": 420,
        "wires": [
            [
                "94b9b86d83a26593"
            ]
        ]
    },
    {
        "id": "94b9b86d83a26593",
        "type": "change",
        "z": "16875acb6e261384",
        "name": "Switch topic and msg",
        "rules": [
            {
                "t": "set",
                "p": "topic",
                "pt": "msg",
                "to": "payload",
                "tot": "msg"
            }
        ],
